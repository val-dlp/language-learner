{
  "name": "language-learner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "embed": "node --import tsx scripts/embed.ts",
    "evaluate": "node --import tsx scripts/evaluate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app components lib scripts tests *.ts *.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  },
  "type": "module"
}
